# Generado a .env por `python3 scripts/bootstrap_env.py`.
# Los valores __GENERATE__ se sustituyen por secretos aleatorios locales.
# No uses estos valores fuera de un entorno de demo.

APP_MODE=demo

# Reloj de negocio fijo para que los documentos sintéticos fechados sean reproducibles
# (TDD §11.1). Avanza desde FIXED_NOW al ritmo del reloj real; timeouts y límites usan
# siempre tiempo real.
CLOCK_MODE=fixed
FIXED_NOW=2026-09-24T12:00:00Z

# PostgreSQL (solo red interna de Compose)
POSTGRES_DB=auto_equity
POSTGRES_USER=auto_equity
POSTGRES_PASSWORD=__GENERATE__
# DATABASE_URL lo construye docker-compose.yml a partir de las tres variables anteriores.

# MinIO: credenciales root solo para minio y minio-init; nunca para la api
MINIO_ROOT_USER=minio-root
MINIO_ROOT_PASSWORD=__GENERATE__

# Usuario de aplicación de MinIO, restringido al bucket (solo api)
DOCUMENT_STORE=s3
S3_ENDPOINT_URL=http://minio:9000
S3_REGION=us-east-1
S3_BUCKET=auto-equity-documents
S3_ACCESS_KEY_ID=auto-equity-api
S3_SECRET_ACCESS_KEY=__GENERATE__

# Puertos locales (solo 127.0.0.1): API y pantalla del asesor (/asesor), agente y chat
API_PORT=8000
AGENT_PORT=2026
CHAT_UI_PORT=3000

# Datos locales de la API
DEMO_CREDENTIALS_PATH=/data/demo-credentials.json
TRACE_DIR=/data/traces
REPORT_DIR=/app/reports

# Langfuse. Perfil evaluador: desactivado de forma explícita (no requiere cuenta).
# Perfil demo integrada: LANGFUSE_ENABLED=true y completar las tres variables siguientes.
LANGFUSE_ENABLED=false
LANGFUSE_BASE_URL=https://cloud.langfuse.com
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_ENVIRONMENT=local
# JSON de tarifas USD / millón de tokens, con clave exacta proveedor:modelo.
# Tarifa estándar verificada el 29/09/2026: entrada, salida y lectura de caché.
# Fuente: https://developers.openai.com/api/docs/models/gpt-4.1-mini
# No selecciona proveedor/modelo ni cambia presupuestos. Otros modelos requieren su tarifa.
# {} = costo desconocido; configuración y límites en docs/auto_equity_TDD.md §10.2.
MODEL_PRICES={"openai:gpt-4.1-mini":{"input":0.40,"output":1.60,"cache_read":0.10}}

# Anthropic u OpenAI. Modelos vacíos solo para Anthropic = los ya usados en la demo:
# chat claude-sonnet-5; documentos claude-opus-5. Las dos funciones siguen separadas.
# CHAT_PROVIDER: anthropic u openai. EXTRACTION_PROVIDER: fake, anthropic u openai.
# fake lee fixtures por hash, sin costo. Los otros leen documentos reales, sin fallback.
# OpenAI exige CHAT_MODEL / EXTRACTION_MODEL explícito según el uso y OPENAI_API_KEY.
# Anthropic conserva los modelos predeterminados. La API con fake funciona sin cuenta.
CHAT_PROVIDER=anthropic
CHAT_MODEL=
EXTRACTION_PROVIDER=fake
EXTRACTION_MODEL=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
